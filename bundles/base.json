[
  {
    "id": "policy",
    "name": "policy:core",
    "config": {
      "mode": "default",
      "sandbox": "workspace-write",
      "allow": ["read_file", "list_dir", "grep", "tool_search", "skill_list", "memory_recall", "spawn_subagent"],
      "ask": ["shell_exec"],
      "deny": []
    }
  },
  {
    "id": "loop",
    "name": "loop:core",
    "config": { "maxSteps": 12, "maxDepth": 2, "spawnBudget": 8 }
  },
  {
    "id": "model",
    "name": "model:router",
    "config": {
      "primary": ["deepseek", "deepseek-flash"],
      "fallback": [["mimo", "claude-sonnet-5"], ["review", "claude-opus-5"]],
      "moa": true,
      "moaModels": [["deepseek", "deepseek-flash"], ["mimo", "claude-sonnet-5"]],
      "routing": {
        "strategy": "balanced",
        "tiers": [["mimo", "claude-sonnet-5"], ["deepseek", "deepseek-flash"]],
        "premium": [["review", "claude-opus-5"]],
        "small": ["deepseek", "deepseek-flash"],
        "notes": "三档智能路由（0.7.0）：tiers 按档位排序（mimo=入门主力，deepseek=中端主力），premium = 高端集成裁决档。strategy 可被 CLI --strategy 覆盖。"
      },
      "notes": "实测（2026-09-14，同一题 + 同一套隐藏断言）：deepseek-flash 简单题 10/10 且 4.1s/886tok；难题 14/14 且 51.7s/12000tok。deepseek-v4-pro 简单题也 10/10，但 80.4s/6422tok；难题在 12000 tok / 150.9s 内只输出推理、未给出函数定义。→ 不按成本档假设能力：flash 是默认 Agent 档，pro 只在题面明确需要长篇推演且 maxTokens 给到 32000 以上时使用。"
    }
  },
  {
    "id": "thinking",
    "name": "thinking:mode",
    "config": {
      "mode": "off",
      "notes": "三档沉思模式（capability thinking.mode）：off=默认不开启 / smart=按任务复杂度智能选择（触发词或长文本，消费库函数 looks_complex）/ on=默认开启。启用后运行首尾消费 should_think/estimate_budget/build_thinking_task/split_thinking/converged。"
    }
  },
  {
    "id": "deepseek",
    "name": "provider:deepseek",
    "config": {
      "wire": "openai",
      "baseURL": "https://api.deepseek.com",
      "apiKey": { "$expr": "get('env.FORGE_DEEPSEEK_KEY', '')" },
      "model": "deepseek-flash",
      "smallModel": "deepseek-flash",
      "notes": "默认 provider：官方 OpenAI 兼容接口；凭据由环境变量注入（FORGE_DEEPSEEK_KEY），不落盘、不进日志。"
    }
  },
  {
    "id": "mimo",
    "name": "provider:mimo",
    "config": {
      "wire": "anthropic",
      "baseURL": "http://127.0.0.1:8810",
      "apiKey": { "$expr": "get('env.FORGE_MIMO_KEY', 'local')" },
      "model": "claude-sonnet-5",
      "notes": "示例 provider：本地环回协议翻译网关（需自备；端口与上游映射按你的网关调整，不用可整段删除）。"
    }
  },
  {
    "id": "review",
    "name": "provider:review",
    "config": {
      "wire": "anthropic",
      "baseURL": "http://127.0.0.1:8811",
      "apiKey": { "$expr": "get('env.FORGE_REVIEW_KEY', 'local')" },
      "model": "claude-opus-5",
      "notes": "示例 provider：独立审查通道；示例指向本地网关，按需替换为你自己的高成本档。"
    }
  }
]
