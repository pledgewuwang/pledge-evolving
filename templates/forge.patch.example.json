[
  {
    "id": "deepseek",
    "name": "provider:deepseek",
    "config": {
      "wire": "openai",
      "baseURL": "https://api.deepseek.com",
      "apiKey": { "$expr": "get('env.FORGE_DEEPSEEK_KEY', '')" },
      "model": "deepseek-flash",
      "smallModel": "deepseek-flash",
      "notes": "用户层覆盖示例：凭据从进程环境变量读取，永不落盘、不出现在命令行或日志。设置方式（PowerShell）：[Environment]::SetEnvironmentVariable('FORGE_DEEPSEEK_KEY','sk-...','User')，重开终端生效。"
    }
  },
  {
    "id": "mimo",
    "name": "provider:mimo",
    "config": {
      "wire": "anthropic",
      "baseURL": "http://127.0.0.1:8810",
      "apiKey": { "$expr": "get('env.FORGE_MIMO_KEY', 'local')" },
      "model": "claude-sonnet-5",
      "notes": "备用档示例：本机环回协议翻译网关时，凭据通常无所谓，但同样走 $expr 保持一致口径。"
    }
  },
  {
    "id": "policy",
    "name": "policy:core",
    "config": {
      "mode": "acceptEdits",
      "sandbox": "workspace-write",
      "allow": ["read_file", "list_dir", "grep", "write_file", "tool_search", "skill_list", "memory_recall", "spawn_subagent"],
      "ask": ["shell_exec"],
      "deny": []
    }
  }
]
